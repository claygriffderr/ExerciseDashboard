# Copy this file to .env for local development: cp .env.example .env

# SQLite database file. Relative paths resolve from the project root.
DATABASE_URL="file:./data/dev.db"

# Set to "false" to stop new people from creating accounts (existing users can still log in).
ALLOW_SIGNUPS="true"

# Session cookies are marked Secure (HTTPS only) in production by default.
# Set to "false" ONLY if you serve the app over plain HTTP on a trusted home network.
# Browsers treat http://localhost as secure, so local use works either way.
# SECURE_COOKIES="true"

# How many reverse proxies (nginx, Caddy, Traefik...) sit in front of the app.
# Used to find the real client IP for login rate limiting. Leave at 0 if none.
TRUSTED_PROXY_COUNT="0"
